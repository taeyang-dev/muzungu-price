DATABASE_URL="file:./prisma/dev.db"
AUTH_SECRET="change-this-secret"

# Email verification delivery (Resend)
AUTH_RESEND_API_KEY=""
AUTH_RESEND_FROM="Muzungu Price <no-reply@example.com>"

# SMS / WhatsApp verification delivery (Twilio)
AUTH_TWILIO_ACCOUNT_SID=""
AUTH_TWILIO_AUTH_TOKEN=""
AUTH_TWILIO_SMS_FROM="+10000000000"
AUTH_TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
AUTH_DEFAULT_COUNTRY_CODE="250"

# Optional webhook fallback (if not using direct providers)
# AUTH_EMAIL_WEBHOOK_URL=""
# AUTH_EMAIL_WEBHOOK_TOKEN=""
# AUTH_SMS_WEBHOOK_URL=""
# AUTH_SMS_WEBHOOK_TOKEN=""
# AUTH_WHATSAPP_WEBHOOK_URL=""
# AUTH_WHATSAPP_WEBHOOK_TOKEN=""

# In production keep this false (or unset)
AUTH_ALLOW_MOCK_VERIFICATION="false"
